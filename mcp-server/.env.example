# HTTP transport for Railway. Use "stdio" only for local process integrations.
MCP_TRANSPORT=http
HOST=0.0.0.0
PORT=3002
MCP_API_KEY=replace-with-a-long-random-secret
MCP_MAX_SESSIONS=100

# Arc Testnet RPC and fallbacks
RPC_ARC_TESTNET=https://rpc.testnet.arc.network
RPC_ARC_FALLBACK_URLS=https://rpc.drpc.testnet.arc.network,https://rpc.quicknode.testnet.arc.network

# Vitael contracts on Arc Testnet
LENDING_POOL=0xEa282eea5bC90905C15Df05Ca43eeA967BcDe49f
USDC_VAULT=0x78C1a89ba59f14542b16e81E60363B7a71e31a4B
