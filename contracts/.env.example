# Private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URLs
ARC_RPC_URL=https://rpc.testnet.arc.network
ETHEREUM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Etherscan API keys (for verification)
ETHERSCAN_API_KEY=your_etherscan_api_key
ARCSCAN_API_KEY=your_arcscan_api_key

# Contract addresses (after deployment)
LENDING_POOL_ADDRESS=
USDC_ADDRESS=
EURC_ADDRESS=
CIRBTC_ADDRESS=
VAULT_DEPOSIT_CAP=10000000000

# Oracle addresses
STORK_ORACLE_ADDRESS=
USDC_PRICE_FEED=
EURC_PRICE_FEED=
CIRBTC_PRICE_FEED=

# Required by vault/DEX deployment; use 5042 with mainnet configuration.
DEPLOY_CHAIN_ID=5042002
# Expected oracle of LENDING_POOL_ADDRESS (required by vault preflight)
ORACLE_ADDRESS=
